# Configuración local del acceso a datos mediante la API corporativa.
# Copia este archivo como .env dentro de esta carpeta y ajusta los valores.
DB_API_BASE_URL=https://est02des.magna.global/est_api
DB_SERVER=EST02DB
DB_DATABASE=SOE
DB_API_TIMEOUT=20000

# Contraseñas almacenadas como hash scrypt (no guardar contraseñas en texto claro).
AUTH_MANAGER_USERNAME=gerente123@
AUTH_MANAGER_PASSWORD_SALT=
AUTH_MANAGER_PASSWORD_HASH=
AUTH_SUPERINTENDENTE_USERNAME=super123@intendente
AUTH_SUPERINTENDENTE_PASSWORD_SALT=
AUTH_SUPERINTENDENTE_PASSWORD_HASH=
# Opcional: cuenta local adicional de Administrador. Windows Authentication sigue disponible.
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD_SALT=
AUTH_ADMIN_PASSWORD_HASH=
# Secreto aleatorio de al menos 32 bytes para firmar sesiones; mantener privado.
AUTH_SESSION_SECRET=

# UPNs de Windows autorizados como Administrador, separados por comas.
WINDOWS_ADMIN_USERS=alejandro.puente1@magna.com
# Secreto aleatorio de al menos 32 bytes, compartido solo con la ruta Windows de IIS.
WINDOWS_AUTH_PROXY_KEY=
